{
  "name": "@knosys/app-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --strictPort",
    "build": "vite build && node ../../scripts/build-web-server.ts",
    "start": "node dist/server.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@knosys/web-core": "workspace:*",
    "@knosys/sdk": "workspace:*",
    "koa": "^3.2.0",
    "@koa/bodyparser": "^6.1.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "@heroui/react": "3.0.3",
    "@heroui/styles": "3.0.3",
    "@heroicons/react": "2.2.0"
  },
  "devDependencies": {
    "vite": "^7.3.1",
    "@tailwindcss/vite": "4.2.4",
    "tailwindcss": "4.2.4",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/koa": "^2.15.0",
    "@types/node": "^24.0.0"
  }
}
